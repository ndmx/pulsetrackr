{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PulseTrackrContractRoot",
  "type": "object",
  "properties": {
    "IncidentCategory": {
      "$ref": "#/definitions/IncidentCategory"
    },
    "IncidentSeverity": {
      "$ref": "#/definitions/IncidentSeverity"
    },
    "IncidentStatus": {
      "$ref": "#/definitions/IncidentStatus"
    },
    "IncidentSubtype": {
      "$ref": "#/definitions/IncidentSubtype"
    },
    "CommunitySignal": {
      "$ref": "#/definitions/CommunitySignal"
    },
    "IncidentConcernReason": {
      "$ref": "#/definitions/IncidentConcernReason"
    },
    "IncidentEvidenceKind": {
      "$ref": "#/definitions/IncidentEvidenceKind"
    },
    "PrivilegedRole": {
      "$ref": "#/definitions/PrivilegedRole"
    },
    "DisclosureScope": {
      "$ref": "#/definitions/DisclosureScope"
    },
    "LegalProcessType": {
      "$ref": "#/definitions/LegalProcessType"
    },
    "NotificationChannel": {
      "$ref": "#/definitions/NotificationChannel"
    },
    "ResolutionReason": {
      "$ref": "#/definitions/ResolutionReason"
    },
    "IncidentEvidence": {
      "$ref": "#/definitions/IncidentEvidence"
    },
    "IncidentEvidenceSummary": {
      "$ref": "#/definitions/IncidentEvidenceSummary"
    },
    "SubmitIncidentPayload": {
      "$ref": "#/definitions/SubmitIncidentPayload"
    },
    "PublicIncident": {
      "$ref": "#/definitions/PublicIncident"
    },
    "IncidentState": {
      "$ref": "#/definitions/IncidentState"
    },
    "SOSLocation": {
      "$ref": "#/definitions/SOSLocation"
    },
    "DirectionOfTravel": {
      "$ref": "#/definitions/DirectionOfTravel"
    },
    "SOSDevice": {
      "$ref": "#/definitions/SOSDevice"
    },
    "PrivacyPolicy": {
      "$ref": "#/definitions/PrivacyPolicy"
    },
    "TrustedContact": {
      "$ref": "#/definitions/TrustedContact"
    },
    "RedactedTrustedContact": {
      "$ref": "#/definitions/RedactedTrustedContact"
    },
    "ActivationPayload": {
      "$ref": "#/definitions/ActivationPayload"
    },
    "LocationUpdatePayload": {
      "$ref": "#/definitions/LocationUpdatePayload"
    },
    "ResolutionPayload": {
      "$ref": "#/definitions/ResolutionPayload"
    },
    "LawEnforcementRequestPayload": {
      "$ref": "#/definitions/LawEnforcementRequestPayload"
    },
    "LawEnforcementReviewPayload": {
      "$ref": "#/definitions/LawEnforcementReviewPayload"
    }
  },
  "definitions": {
    "IncidentCategory": {
      "type": "string",
      "enum": [
        "security",
        "traffic",
        "fire",
        "medical",
        "weather",
        "utilities",
        "structure",
        "community"
      ]
    },
    "IncidentSeverity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ]
    },
    "IncidentStatus": {
      "type": "string",
      "enum": [
        "Active",
        "Watching",
        "Resolved"
      ]
    },
    "IncidentSubtype": {
      "type": "string",
      "enum": [
        "armed_robbery",
        "kidnapping",
        "gunshots",
        "carjacking",
        "one_chance",
        "suspicious_activity",
        "checkpoint_issue",
        "communal_clash",
        "crash",
        "roadblock",
        "gridlock",
        "flooded_road",
        "bad_road",
        "broken_down_vehicle",
        "building_fire",
        "market_fire",
        "gas_leak",
        "explosion",
        "electrical_fire",
        "pipeline_fire",
        "medical_emergency",
        "suspected_outbreak",
        "hospital_issue",
        "medicine_shortage",
        "contaminated_water",
        "food_poisoning",
        "flooding",
        "heavy_rain",
        "storm_damage",
        "erosion_landslide",
        "drought_water_scarcity",
        "power_outage",
        "water_outage",
        "fuel_scarcity",
        "bridge_damage",
        "rail_issue",
        "building_collapse",
        "bridge_collapse",
        "road_collapse",
        "unsafe_building",
        "fallen_power_line",
        "missing_person",
        "local_warning",
        "safe_route",
        "community_watch",
        "public_gathering",
        "aid_needed"
      ]
    },
    "CommunitySignal": {
      "type": "string",
      "enum": [
        "seen",
        "notSeen",
        "unsafe",
        "roadBlocked",
        "cleared"
      ]
    },
    "IncidentConcernReason": {
      "type": "string",
      "enum": [
        "false_report",
        "offensive_content",
        "private_information",
        "dangerous_advice",
        "spam_or_abuse"
      ]
    },
    "IncidentEvidenceKind": {
      "type": "string",
      "enum": [
        "photo",
        "voice"
      ]
    },
    "PrivilegedRole": {
      "type": "string",
      "enum": [
        "sosAdmin",
        "careTeam",
        "lawEnforcement"
      ]
    },
    "DisclosureScope": {
      "type": "string",
      "enum": [
        "last_known_location",
        "direction_of_travel",
        "redacted_trusted_contacts",
        "recent_trail"
      ]
    },
    "LegalProcessType": {
      "type": "string",
      "enum": [
        "warrant",
        "court_order",
        "subpoena",
        "emergency_disclosure_request",
        "other"
      ]
    },
    "NotificationChannel": {
      "type": "string",
      "enum": [
        "sms",
        "phone_call",
        "email",
        "app_push"
      ]
    },
    "ResolutionReason": {
      "type": "string",
      "enum": [
        "user_resolved",
        "false_alarm",
        "timed_out",
        "transferred_to_care_team"
      ]
    },
    "IncidentEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/IncidentEvidenceKind"
        },
        "storage_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "size_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10485760
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "storage_path",
        "content_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "IncidentEvidenceSummary": {
      "type": "object",
      "properties": {
        "photo_count": {
          "type": "integer",
          "minimum": 0
        },
        "voice_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "photo_count",
        "voice_count"
      ],
      "additionalProperties": false
    },
    "SubmitIncidentPayload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "category": {
          "$ref": "#/definitions/IncidentCategory"
        },
        "subtype": {
          "$ref": "#/definitions/IncidentSubtype"
        },
        "severity": {
          "$ref": "#/definitions/IncidentSeverity"
        },
        "status": {
          "$ref": "#/definitions/IncidentStatus"
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "use_approximate_location": {
          "type": "boolean"
        },
        "client_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IncidentEvidence"
          },
          "maxItems": 4
        }
      },
      "required": [
        "title",
        "summary",
        "category",
        "subtype",
        "severity",
        "status",
        "neighborhood",
        "use_approximate_location",
        "client_ref",
        "source",
        "evidence"
      ],
      "additionalProperties": false
    },
    "PublicIncident": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "category": {
          "$ref": "#/definitions/IncidentCategory"
        },
        "subtype": {
          "$ref": "#/definitions/IncidentSubtype"
        },
        "severity": {
          "$ref": "#/definitions/IncidentSeverity"
        },
        "status": {
          "$ref": "#/definitions/IncidentStatus"
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "latitude": {
          "$ref": "#/definitions/SubmitIncidentPayload/properties/latitude"
        },
        "longitude": {
          "$ref": "#/definitions/SubmitIncidentPayload/properties/longitude"
        },
        "geohash": {
          "type": "string",
          "pattern": "^[0-9b-hjkmnp-z]+$"
        },
        "public_h3_cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "public_h3_resolution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "location_reveal_status": {
          "type": "string",
          "enum": [
            "revealed",
            "pending_k_anonymity"
          ]
        },
        "location_privacy_policy": {
          "type": "string",
          "enum": [
            "h3_k_anonymous"
          ]
        },
        "k_anonymity_threshold": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "k_anonymity_distinct_reporters": {
          "type": "integer",
          "minimum": 0
        },
        "confirmations": {
          "type": "integer",
          "minimum": 0
        },
        "disputes": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_reports": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_reports": {
          "type": "integer",
          "minimum": 0
        },
        "cleared_reports": {
          "type": "integer",
          "minimum": 0
        },
        "official_updates": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_summary": {
          "$ref": "#/definitions/IncidentEvidenceSummary"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "title",
        "summary",
        "category",
        "subtype",
        "severity",
        "status",
        "neighborhood",
        "confirmations",
        "disputes",
        "unsafe_reports",
        "blocked_reports",
        "cleared_reports",
        "official_updates",
        "reported_at"
      ],
      "additionalProperties": false
    },
    "IncidentState": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/IncidentStatus"
        },
        "severity": {
          "$ref": "#/definitions/IncidentSeverity"
        },
        "confirmations": {
          "type": "integer",
          "minimum": 0
        },
        "disputes": {
          "type": "integer",
          "minimum": 0
        },
        "unsafeReports": {
          "type": "integer",
          "minimum": 0
        },
        "blockedReports": {
          "type": "integer",
          "minimum": 0
        },
        "clearedReports": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "severity",
        "confirmations",
        "disputes",
        "unsafeReports",
        "blockedReports",
        "clearedReports"
      ],
      "additionalProperties": false
    },
    "SOSLocation": {
      "type": "object",
      "properties": {
        "latitude": {
          "$ref": "#/definitions/SubmitIncidentPayload/properties/latitude"
        },
        "longitude": {
          "$ref": "#/definitions/SubmitIncidentPayload/properties/longitude"
        },
        "horizontalAccuracyMeters": {
          "type": "number",
          "minimum": 0
        },
        "altitudeMeters": {
          "type": "number"
        },
        "speedMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "courseDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "capturedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "capturedAt"
      ],
      "additionalProperties": false
    },
    "DirectionOfTravel": {
      "type": "object",
      "properties": {
        "bearingDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "speedMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "computedFromPointCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "SOSDevice": {
      "type": "object",
      "properties": {
        "batteryLevelPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "batteryState": {
          "type": "string",
          "maxLength": 64
        },
        "lowPowerModeEnabled": {
          "type": "boolean"
        },
        "networkStatus": {
          "type": "string",
          "maxLength": 64
        },
        "networkInterfaceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 6
        },
        "appVersion": {
          "type": "string",
          "maxLength": 64
        },
        "buildNumber": {
          "type": "string",
          "maxLength": 64
        },
        "deviceModel": {
          "type": "string",
          "maxLength": 128
        },
        "systemVersion": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "PrivacyPolicy": {
      "type": "object",
      "properties": {
        "includeRecentTrail": {
          "type": "boolean"
        },
        "recentTrailMaxPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "recentTrailMaxAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "liveLocationUpdateIntervalSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        },
        "shareExactLocationWithTrustedContacts": {
          "type": "boolean"
        },
        "adminAccessExpiresAfterSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "lawEnforcementAccessRequiresActiveSession": {
          "type": "boolean"
        },
        "auditPrivilegedAccess": {
          "type": "boolean"
        }
      },
      "required": [
        "includeRecentTrail",
        "recentTrailMaxPoints",
        "recentTrailMaxAgeSeconds",
        "liveLocationUpdateIntervalSeconds",
        "shareExactLocationWithTrustedContacts",
        "adminAccessExpiresAfterSeconds",
        "lawEnforcementAccessRequiresActiveSession",
        "auditPrivilegedAccess"
      ],
      "additionalProperties": false
    },
    "TrustedContact": {
      "type": "object",
      "properties": {
        "contactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "relationshipLabel": {
          "type": "string",
          "maxLength": 128
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 64
        },
        "emailAddress": {
          "type": "string",
          "maxLength": 256
        },
        "appUserUid": {
          "type": "string",
          "maxLength": 128
        },
        "appRelationshipId": {
          "type": "string",
          "maxLength": 128
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NotificationChannel"
          },
          "minItems": 1
        },
        "consentedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        }
      },
      "required": [
        "contactId",
        "displayName",
        "channels"
      ],
      "additionalProperties": false
    },
    "RedactedTrustedContact": {
      "type": "object",
      "properties": {
        "contactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "relationshipLabel": {
          "type": "string",
          "maxLength": 128
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NotificationChannel"
          }
        },
        "phoneLast4": {
          "type": "string",
          "maxLength": 4
        },
        "hasEmailAddress": {
          "type": "boolean"
        },
        "appRelationshipId": {
          "type": "string",
          "maxLength": 128
        },
        "hasAppRoute": {
          "type": "boolean"
        },
        "consentedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        }
      },
      "required": [
        "contactId",
        "displayName",
        "channels",
        "hasEmailAddress",
        "hasAppRoute"
      ],
      "additionalProperties": false
    },
    "ActivationPayload": {
      "type": "object",
      "properties": {
        "clientSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "activatedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        },
        "lastKnownLocation": {
          "$ref": "#/definitions/SOSLocation"
        },
        "recentTrail": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SOSLocation"
          },
          "maxItems": 24
        },
        "directionOfTravel": {
          "anyOf": [
            {
              "$ref": "#/definitions/DirectionOfTravel"
            },
            {
              "type": "null"
            }
          ]
        },
        "trustedContacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TrustedContact"
          },
          "maxItems": 10
        },
        "device": {
          "$ref": "#/definitions/SOSDevice"
        },
        "privacy": {
          "$ref": "#/definitions/PrivacyPolicy"
        }
      },
      "required": [
        "clientSessionId",
        "source",
        "activatedAt",
        "lastKnownLocation",
        "recentTrail",
        "directionOfTravel",
        "trustedContacts",
        "device",
        "privacy"
      ],
      "additionalProperties": false
    },
    "LocationUpdatePayload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "location": {
          "$ref": "#/definitions/SOSLocation"
        },
        "sequenceNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        },
        "directionOfTravel": {
          "anyOf": [
            {
              "$ref": "#/definitions/DirectionOfTravel"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "$ref": "#/definitions/SOSDevice"
        }
      },
      "required": [
        "sessionId",
        "location",
        "sequenceNumber",
        "capturedAt",
        "directionOfTravel",
        "device"
      ],
      "additionalProperties": false
    },
    "ResolutionPayload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "$ref": "#/definitions/ResolutionReason"
        },
        "resolvedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        },
        "finalLocation": {
          "anyOf": [
            {
              "$ref": "#/definitions/SOSLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sessionId",
        "reason",
        "resolvedAt",
        "finalLocation"
      ],
      "additionalProperties": false
    },
    "LawEnforcementRequestPayload": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agencyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requesterTitle": {
          "type": "string",
          "maxLength": 200
        },
        "requesterEmail": {
          "type": "string",
          "maxLength": 256
        },
        "requesterPhone": {
          "type": "string",
          "maxLength": 64
        },
        "legalProcessType": {
          "$ref": "#/definitions/LegalProcessType"
        },
        "legalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "documentReference": {
          "type": "string",
          "maxLength": 500
        },
        "requestedScope": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DisclosureScope"
          }
        },
        "urgency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "receivedAt": {
          "$ref": "#/definitions/PublicIncident/properties/reported_at"
        }
      },
      "required": [
        "sessionId",
        "agencyName",
        "requesterName",
        "legalProcessType",
        "legalReference",
        "requestedScope",
        "urgency",
        "receivedAt"
      ],
      "additionalProperties": false
    },
    "LawEnforcementReviewPayload": {
      "type": "object",
      "properties": {
        "legalRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "denied"
          ]
        },
        "approvedScope": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DisclosureScope"
          }
        },
        "reviewNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expiresAt": {
          "anyOf": [
