{
  "name": "pulsetrackr-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "npm run sync:contract && tsc",
    "sync:contract": "node scripts/sync-contract.cjs",
    "test": "npm run build && node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pulsetrackr-rules \"node --test test/firestoreRules.emulator.js\"",
    "test:geo": "firebase emulators:exec --only firestore --project demo-pulsetrackr-geo \"node --test test/geoQuery.emulator.js\"",
    "lint": "tsc --noEmit",
    "set-sos-claim": "node scripts/setSosRoleClaim.js"
  },
  "dependencies": {
    "@pulsetrackr/contract": "file:vendor/contract",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "h3-js": "^4.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
