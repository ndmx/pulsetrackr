# Non-secret local emulator values.
# Secret values belong in functions/.secret.local for Firebase Functions.

# Optional custom voice call TwiML. If omitted, PulseTrackr generates a short spoken SOS message.
# TWILIO_VOICE_TWIML=<Response><Say>PulseTrackr SOS alert.</Say></Response>

# Optional display name for Twilio Comms Email.
TWILIO_EMAIL_FROM_NAME=PulseTrackr SOS

# Privacy/security policy defaults.
SOS_ENVELOPE_KEY_VERSION=v1
PULSETRACKR_PUBLIC_H3_RESOLUTION=8
PULSETRACKR_PUBLIC_H3_FALLBACK_RESOLUTION=7
PULSETRACKR_K_ANONYMITY_THRESHOLD=3

# Optional override for Twilio request-signature validation if Firebase's
# generated HTTPS URL differs from the URL configured in Twilio.
# TWILIO_WEBHOOK_PUBLIC_URL=https://us-central1-your-project.cloudfunctions.net/twilio_sms_webhook
