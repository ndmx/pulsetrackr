# Firebase Functions emulator secret overrides.
# Copy to functions/.secret.local and fill in real local-only values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-with-api-key-secret
TWILIO_AUTH_TOKEN=replace-with-account-auth-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_EMAIL_FROM_ADDRESS=sos@example.com
SOS_ENVELOPE_KEK=base64-or-hex-32-byte-key
